{
  "name": "bootstrap-scaffold",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "server:dev": "dotenv -e .env -- tsx watch server/src/index.ts",
    "server:start": "dotenv -e .env -- tsx server/src/index.ts",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "server:lint": "eslint server --ext .ts",
    "server:test": "vitest run --config server/vitest.config.ts",
    "client:test": "vitest run services/search-client.test.ts services/search-state.test.ts",
    "app:test": "jest components/search-results-section.test.tsx --runInBand",
    "validate": "npm run server:typecheck && npm run server:lint && npm run server:test && npm run client:test && npm run app:test && npm run typecheck && npm run lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- tsx server/src/db/migrate.ts",
    "db:seed": "dotenv -e .env -- tsx server/src/db/seed.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "@hono/node-server": "^1.13.8",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.6.10",
    "postgres": "^3.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "~19.1.0",
    "@types/jest": "^29.5.14",
    "typescript": "~5.9.2",
    "@testing-library/react-native": "^13.3.3",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.8",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "private": true
}
