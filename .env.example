# Supabase Postgres connection string used by runtime, migrations, and seeds.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recipe_finder

# Optional shadow database used by some migration workflows.
DATABASE_SHADOW_URL=postgres://postgres:postgres@localhost:5432/recipe_finder_shadow

# Public API base URL consumed by the Expo app.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
